[run]
branch = True
source =
    tracker
    scripts
omit =
    */tests/*

[report]
show_missing = True
skip_covered = False
precision = 2
# Report branch gaps for review without turning aggregate percentage drift into
# a failure unrelated to the behavior exercised by the test suite.

[xml]
output = coverage/python/coverage.xml

[json]
output = coverage/python/coverage.json
pretty_print = True
