#!/usr/bin/env sh
# Block a commit that CI's formatting gate would reject.
#
# Formatting is the one check that is instant locally and a hard failure
# remotely, so catching it here removes a whole class of red build and keeps
# the history free of commits that only exist to reformat a parent.
#
# Install with:      git config core.hooksPath .githooks
# Bypass once with:  git commit --no-verify
#
# Note that cargo fmt inspects the working tree rather than the staged
# content, so an unformatted unstaged edit can block an otherwise clean
# commit. Bypassing is the right move in that rare case.

if git diff --cached --name-only --diff-filter=ACMR |
  grep -q '^dashboard/src-tauri/.*\.rs$'; then
  if ! cargo fmt --manifest-path dashboard/src-tauri/Cargo.toml --check; then
    echo
    echo 'Commit blocked: Rust sources are not formatted.'
    echo 'Fix with:   cargo fmt --manifest-path dashboard/src-tauri/Cargo.toml'
    echo 'Bypass with: git commit --no-verify'
    exit 1
  fi
fi
