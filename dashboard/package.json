{
  "name": "dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc && vite build --configLoader runner",
    "build:tracker": "python ../scripts/build_tracker.py",
    "preview": "vite preview --configLoader runner",
    "test": "vitest run --configLoader runner",
    "test:device:serve": "vite --config device-test/vite.config.ts --configLoader runner",
    "test:device": "playwright test",
    "test:native:prepare": "python ../scripts/make_demo_db.py --out ../data/device-compat.db --weeks 12 --force && python device-test/native/prepare_db.py ../data/device-compat.db",
    "test:native": "npm run test:native:prepare && wdio run wdio.native.conf.mjs",
    "build:native-device": "tauri build --debug --no-bundle --config src-tauri/device-test.conf.json",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "echarts": "^6.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "overrides": {
    "@wdio/native-utils": "2.5.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.3",
    "@wdio/cli": "^9.30.0",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/tauri-service": "^1.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
