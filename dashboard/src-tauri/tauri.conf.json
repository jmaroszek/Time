{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Time",
  "version": "1.1.0",
  "identifier": "com.trackwithtime.time",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "npm run build:tracker",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Time",
        "width": 1200,
        "height": 800,
        "minWidth": 500,
        "minHeight": 480,
        "center": true,
        "maximized": false,
        "visible": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Jonah Maroszek",
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/time-tracker"],
    "resources": {
      "binaries/_internal/": "_internal/"
    },
    "windows": {
      "signCommand": {
        "cmd": "pwsh",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-NonInteractive",
          "-File",
          "../scripts/sign_release_artifact.ps1",
          "-Artifact",
          "%1"
        ]
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzQTUzMDBBNkQyRkRGNTUKUldSVjN5OXRDakNsUTlKejRTN1R2c05pbmRPakhPbG5Pd0JXWnl6UlZlZkM5eE5qcXhqNUFFQmgK",
      "endpoints": ["https://trackwithtime.com/updates/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
