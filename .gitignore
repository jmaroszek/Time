__pycache__/
# A stray root-level npm install; the dashboard's own deps are ignored under
# dashboard/.gitignore. Anchored so it can't mask a tracked node_modules deeper in.
/node_modules/
tracker/build/
tracker/dist/
dashboard/src-tauri/binaries/
/data/
/Images/
/Logs/
features_to_add.txt
database.db
time_tracker.log*
database.db-shm
database.db-wal
# The pre-rename name, so an archived history can never be committed either.
time_log.db
time_log.db-shm
time_log.db-wal
/.coverage
/coverage/
/dashboard/coverage/
# Owner-only working documents (audits, roadmaps, runbooks). One directory
# rule rather than a per-file list, so a new document is private by default.
docs/personal/
# The updater's Ed25519 private key belongs outside this repository entirely;
# these are a backstop for a `tauri signer generate` run in the wrong directory.
# Committing one would let anyone sign an update that every installed copy of
# Time accepts, and rotating it strands every install that already exists.
/*.key
/*.key.pub

# Claude Code's working directory: launch config, local permissions, scheduler
# state. None of it is product source, and it describes the tooling rather than
# the project. Ignored whole, so anything the tool drops here later is private
# by default instead of needing a new rule each time.
/.claude/

# Wrangler scratch state from update-rehearsal runs. Empty today, which is the
# only reason it has never been committed by accident.
/.wrangler/

# Owner-only working notes. Agent tools read these from the working tree, so
# they stay on disk and out of the published repository — the public equivalent
# is CONTRIBUTING.md, which is written for contributors rather than for the
# owner's own process.
/AGENTS.md
/CLAUDE.md
